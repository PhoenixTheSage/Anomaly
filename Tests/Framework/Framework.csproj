<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion><PlatformTarget>x64</PlatformTarget>
    <Bin64 Condition="'$(Bin64)' == ''">T:/SteamLibrary/steamapps/common/SpaceEngineers/Bin64</Bin64>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ClientPlugin/ShaderFramework/QueuedArtResource.cs" Link="QueuedArtResource.cs"/>
    <Compile Include="../../ClientPlugin/ShaderFramework/VolumetricInteriorUpload.cs" Link="VolumetricInteriorUpload.cs"/>
    <Compile Include="../../ClientPlugin/ShaderFramework/VolumetricMediumRegistry.cs" Link="VolumetricMediumRegistry.cs"/>
    <Compile Include="../../ClientPlugin/ShaderFramework/VolumeCompositeRecovery.cs" Link="VolumeCompositeRecovery.cs"/>
    <Compile Include="../../ClientPlugin/ShaderFramework/RenderTextureCheckpoint.cs" Link="RenderTextureCheckpoint.cs"/>
    <Reference Include="VRage.Math"><HintPath>$(Bin64)/VRage.Math.dll</HintPath></Reference>
    <Reference Include="SharpDX"><HintPath>$(Bin64)/SharpDX.dll</HintPath></Reference>
    <Reference Include="SharpDX.Direct3D11"><HintPath>$(Bin64)/SharpDX.Direct3D11.dll</HintPath></Reference>
    <Reference Include="SharpDX.DXGI"><HintPath>$(Bin64)/SharpDX.DXGI.dll</HintPath></Reference>
  </ItemGroup>
</Project>
